# Database
DB_URL=jdbc:postgresql://localhost:5432/stockhub
DB_USERNAME=stockhub
DB_PASSWORD=stockhub

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT (leave empty to auto-generate RSA key pair on startup)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth2 (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
CORS_ORIGINS=http://localhost:4200,https://stockhub.vercel.app

# Ingestion
INGESTION_ENABLED=true

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
